# Fixed dogfood identity. Reused across branches; saved state survives updates.
# The tagged-dev namespace gives this Release build an isolated socket and
# marker through existing runtime policy, and disables upstream updates.
RBF_APP_NAME="cmux RBF (dogfood)"
RBF_BUNDLE_ID="com.cmuxterm.app.debug.rbf.dogfood"
RBF_PLUGIN_BUNDLE_ID="com.cmuxterm.app.debug.rbf.dogfood.docktileplugin"
RBF_INSTALL_PATH="/Applications/cmux RBF (dogfood).app"
RBF_ICON_SET="AppIcon-RBF"
RBF_VERSION_PLIST_KEY="RBFVersion"
UPSTREAM_BUNDLE_ID="com.cmuxterm.app"
UPSTREAM_INSTALL_PATH="/Applications/cmux.app"
