{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmux.dev/schemas/restart-commands.schema.json",
  "title": "__TITLE__",
  "description": "__ROOT_DESCRIPTION__",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "definitions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "definitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "command", "cwd"],
        "properties": {
          "id": { "enum": ["jjui", "jjui-brief", "hunk"] },
          "match": {
            "description": "__MATCH_DESCRIPTION__",
            "type": "object",
            "additionalProperties": false,
            "required": ["executable"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "argumentTailPrefix": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state"],
                  "properties": {
                    "state": { "enum": ["absent", "present"] },
                    "normalizedFinalComponent": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "command": {
            "description": "__COMMAND_DESCRIPTION__",
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "description": "__CWD_DESCRIPTION__",
            "const": "saved"
          }
        }
      }
    }
  }
}
